{
  "name": "governance-ai-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "description": "Laboratorio de aprendizaje: capa de gobernanza para agentes de IA, fase por fase y 100% TypeScript.",
  "scripts": {
    "demo": "tsx src/demo/run-demo.ts",
    "test": "vitest run",
    "test:baseline": "vitest run src/tests/tools.test.ts src/tests/agent-loop.test.ts",
    "test:phase1": "vitest run src/tests/policy.test.ts src/tests/agent-gate.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:baseline": "tsc --noEmit -p tsconfig.baseline.json",
    "verify": "pnpm test && pnpm typecheck",
    "verify:baseline": "pnpm test:baseline && pnpm typecheck:baseline && pnpm demo"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "yaml": "^2.9.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
