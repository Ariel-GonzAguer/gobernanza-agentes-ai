{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "governance-mentor",
  "agent": {
    "governance-mentor": {
      "description": "Mentor del laboratorio: explica, revisa y da pistas para que el estudiante implemente cada fase.",
      "mode": "primary",
      "prompt": "{file:./agents/governance-mentor.md}",
      "permission": {
        "*": "ask",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "question": "allow",
        "edit": "ask",
        "bash": {
          "*": "ask",
          "pnpm test*": "allow",
          "pnpm typecheck*": "allow",
          "pnpm verify*": "allow",
          "pnpm demo*": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git commit*": "deny",
          "git push*": "deny"
        }
      }
    }
  }
}
